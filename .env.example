# ==========================================
# CẤU HÌNH TELEGRAM BOT
# ==========================================
# 1. Tạo bot qua @BotFather trên Telegram để lấy token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# 2. Danh sách Telegram User ID được phép dùng bot (ngăn người lạ spam).
# Lấy ID của bạn bằng cách chat với @userinfobot trên Telegram.
# Có thể điền nhiều ID phân cách bằng dấu phẩy, ví dụ: 12345678,87654321
TELEGRAM_ADMIN_IDS=123456789

# ==========================================
# CẤU HÌNH AI REWRITER & SEO
# ==========================================
# Chọn nhà cung cấp AI: 'gemini' (khuyên dùng - nhanh, rẻ/free) hoặc 'openai'
AI_PROVIDER=gemini

# Google Gemini API Key (Lấy tại https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Nếu chọn AI_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Hướng dẫn phong cách riêng cho AI (Tùy chọn)
# AI_CUSTOM_PROMPT=Hãy thêm lời kêu gọi liên hệ dịch vụ vận tải của công ty ở cuối mỗi bài viết.

# ==========================================
# CẤU HÌNH WORDPRESS
# ==========================================
# URL trang WordPress của bạn (không có dấu gạch chéo ở cuối)
WP_URL=https://yourwebsite.com

# Tên đăng nhập tài khoản quản trị WordPress
WP_USERNAME=admin

# Mật khẩu ứng dụng WordPress (Application Password)
# Cách tạo: Vào WP Admin > Thành viên (Users) > Hồ sơ (Profile) > cuộn xuống "Mật khẩu ứng dụng" (Application Passwords)
# Nhập tên (vd: TelegramBot) -> Bấm "Thêm mật khẩu ứng dụng mới" -> Copy mã (dạng: xxxx xxxx xxxx xxxx)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Trạng thái bài viết mặc định khi tạo: 'draft' (bản nháp) hoặc 'publish' (công khai luôn)
WP_DEFAULT_STATUS=draft

# (Tùy chọn) ID của tác giả bài viết trong WordPress
# WP_AUTHOR_ID=1

# ==========================================
# CẤU HÌNH DATABASE (POSTGRESQL + PGVECTOR)
# ==========================================
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/hs_database
API_PORT=3001
